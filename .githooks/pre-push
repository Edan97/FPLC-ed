#!/bin/sh
# Run the test suite before anything is pushed; a failing test blocks the push.
# Enabled per clone with: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: Node.js not found, so the tests can't run. Install it (brew install node) or push with --no-verify." >&2
  exit 1
fi
echo "pre-push: running tests…"
if ! node --test tests/ >/tmp/fplc-ed-tests.log 2>&1; then
  grep -E "^✖|^ℹ (tests|pass|fail)" /tmp/fplc-ed-tests.log >&2
  echo "pre-push: tests failed, push stopped. Full output in /tmp/fplc-ed-tests.log" >&2
  exit 1
fi
grep -E "^ℹ (tests|pass|fail)" /tmp/fplc-ed-tests.log
